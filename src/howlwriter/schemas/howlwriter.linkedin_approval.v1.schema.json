{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/howlcipher/howlwriter/schemas/howlwriter.linkedin_approval.v1.schema.json",
  "title": "howlwriter.linkedin_approval/v1",
  "description": "A human approval of one LinkedIn post, written only by the trusted approval workflow. The authentication code is an HMAC-SHA256 over the canonical record made with a key held outside the repository. A record that matches this schema is not thereby genuine: only the run time check with the key decides that.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "post_id",
    "content_fingerprint",
    "media",
    "verification",
    "accepted_limitations",
    "limitations_digest",
    "schedule",
    "actor",
    "workflow",
    "approved_at",
    "authentication"
  ],
  "properties": {
    "schema": {
      "const": "howlwriter.linkedin_approval/v1"
    },
    "post_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "content_fingerprint": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "media": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "created_at",
        "verdict",
        "status",
        "howlproof_run_id",
        "howlproof_manifest_sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "created_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "verdict": {
          "enum": [
            "PROVEN",
            "CONDITIONALLY_PROVEN",
            "REQUIRES_HUMAN",
            "REJECT",
            "INSUFFICIENT_EVIDENCE"
          ]
        },
        "status": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "howlproof_run_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "howlproof_manifest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "accepted_limitations": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "string",
        "maxLength": 4000
      }
    },
    "limitations_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "schedule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "date",
        "time"
      ],
      "properties": {
        "date": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "time": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
        }
      }
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "login"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9]{1,20}$"
        },
        "login": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      }
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "repository_id",
        "run_id",
        "run_attempt",
        "workflow_ref",
        "event",
        "ref",
        "sha"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "repository_id": {
          "type": "string",
          "pattern": "^[0-9]{1,20}$"
        },
        "run_id": {
          "type": "string",
          "pattern": "^[0-9]{1,20}$"
        },
        "run_attempt": {
          "type": "string",
          "pattern": "^[0-9]{1,20}$"
        },
        "workflow_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "event": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "sha": {
          "type": "string",
          "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"
        }
      }
    },
    "approved_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "authentication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "key_id",
        "mac"
      ],
      "properties": {
        "method": {
          "const": "hmac-sha256"
        },
        "key_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "mac": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
