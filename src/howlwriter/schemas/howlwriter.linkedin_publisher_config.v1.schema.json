{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/howlcipher/howlwriter/schemas/howlwriter.linkedin_publisher_config.v1.schema.json",
  "title": "howlwriter.linkedin_publisher_config/v1",
  "description": "publisher.yaml in the private publishing repository. Omitted keys take the documented defaults. The run time parser additionally requires default_publish_time to be one of allowed_publish_times and the timezone to be a known IANA zone.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema"
  ],
  "properties": {
    "schema": {
      "const": "howlwriter.linkedin_publisher_config/v1"
    },
    "timezone": {
      "type": "string",
      "minLength": 1,
      "default": "America/Detroit"
    },
    "default_publish_time": {
      "type": "string",
      "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
      "default": "08:30"
    },
    "allowed_publish_times": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
      },
      "default": [
        "08:30",
        "09:00"
      ]
    },
    "max_posts_per_day": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1,
      "default": 1
    },
    "publishing_enabled": {
      "type": "boolean",
      "default": false
    },
    "dry_run": {
      "type": "boolean",
      "default": true
    },
    "max_lateness_minutes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 720,
      "default": 180
    }
  }
}
