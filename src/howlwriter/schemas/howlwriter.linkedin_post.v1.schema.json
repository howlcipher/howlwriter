{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/howlcipher/howlwriter/schemas/howlwriter.linkedin_post.v1.schema.json",
  "title": "howlwriter.linkedin_post/v1",
  "description": "One LinkedIn post record in the private publishing repository. The run time parser in howlwriter.linkedin.models is the authority and is at least as strict: it also checks real calendar dates, IANA timezones, and lifecycle consistency between state, approval, attempts and the LinkedIn post ID.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "revision",
    "title",
    "text",
    "urls",
    "media",
    "created_at",
    "updated_at",
    "scheduled_date",
    "scheduled_time",
    "timezone",
    "state",
    "content_fingerprint",
    "verification_ref",
    "approval_ref",
    "attempts",
    "linkedin_post_id",
    "history"
  ],
  "properties": {
    "schema": {
      "const": "howlwriter.linkedin_post/v1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "title": {
      "type": "string",
      "maxLength": 200,
      "pattern": "\\S",
      "not": {
        "pattern": "[\\n\\r]"
      }
    },
    "text": {
      "type": "string",
      "maxLength": 20000,
      "pattern": "\\S"
    },
    "urls": {
      "type": "array",
      "maxItems": 20,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "maxLength": 2000,
        "pattern": "^https://[^\\s/?#]+[^\\s]*$"
      }
    },
    "media": {
      "type": "array",
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256",
          "alt_text"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^media/[A-Za-z0-9._/-]+$",
            "not": {
              "pattern": "\\.\\."
            }
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "alt_text": {
            "type": "string",
            "maxLength": 4000,
            "pattern": "\\S"
          }
        }
      }
    },
    "created_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "updated_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "scheduled_date": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        }
      ]
    },
    "scheduled_time": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
        }
      ]
    },
    "timezone": {
      "type": "string",
      "minLength": 1
    },
    "state": {
      "enum": [
        "DRAFT",
        "READY_FOR_REVIEW",
        "APPROVED",
        "SCHEDULED",
        "PUBLISHING",
        "PUBLISHED",
        "FAILED",
        "UNCERTAIN",
        "ARCHIVED"
      ]
    },
    "content_fingerprint": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "verification_ref": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256",
            "content_fingerprint"
          ],
          "properties": {
            "path": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._/-]+$",
              "not": {
                "anyOf": [
                  {
                    "pattern": "\\.\\."
                  },
                  {
                    "pattern": "^/"
                  }
                ]
              }
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "content_fingerprint": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          }
        }
      ]
    },
    "approval_ref": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256",
            "content_fingerprint"
          ],
          "properties": {
            "path": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._/-]+$",
              "not": {
                "anyOf": [
                  {
                    "pattern": "\\.\\."
                  },
                  {
                    "pattern": "^/"
                  }
                ]
              }
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "content_fingerprint": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          }
        }
      ]
    },
    "attempts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "attempt_id",
          "started_at",
          "content_fingerprint",
          "outcome",
          "finished_at",
          "detail"
        ],
        "properties": {
          "attempt_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"
          },
          "started_at": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
          },
          "content_fingerprint": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "outcome": {
            "enum": [
              "PENDING",
              "SUCCESS",
              "FAILED",
              "AMBIGUOUS"
            ]
          },
          "finished_at": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
              }
            ]
          },
          "detail": {
            "type": "string",
            "maxLength": 2000
          }
        }
      }
    },
    "linkedin_post_id": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "maxLength": 200,
          "pattern": "\\S",
          "not": {
            "pattern": "[\\n\\r]"
          }
        }
      ]
    },
    "history": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "at",
          "actor",
          "action",
          "detail"
        ],
        "properties": {
          "at": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
          },
          "actor": {
            "type": "string",
            "maxLength": 200,
            "pattern": "\\S"
          },
          "action": {
            "type": "string",
            "maxLength": 200,
            "pattern": "\\S"
          },
          "detail": {
            "type": "string",
            "maxLength": 2000
          }
        }
      }
    }
  }
}
