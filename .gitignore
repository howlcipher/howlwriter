__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
.mypy_cache/
build/
dist/
.venv/
venv/
*.howled.md
.coverage

# Personal voice data. A voice built from someone's own writing is private
# user data and lives in ~/.howlwriter/voices/ by default, outside any repo.
# These patterns cover the case where a development or test run is pointed at
# the working tree instead. The committed schema, the synthetic examples in
# profiles/*.example.yaml, and the tests are deliberately NOT ignored.
.voice/
voices/
voice_corpus/
profiles/private/
*.voice.local.*
*.local.voice.json
dogfood/*results*/
dogfood/*.json

# Generation provenance. A provenance record contains the user's own outline
# text and, at full level, every prompt HowlWriter built around it. It is
# written beside the artifact on request and is never published. Committed
# fixtures under tests/ are synthetic and deliberately NOT ignored.
*.provenance.json
*.manifest.txt
*.outline.yaml
!tests/**/*.outline.yaml

# HowlWriter generated deliverables
output/*
!output/.gitkeep

# External agents / tooling
.agents/
.devin/
